    },
    "s4": {
      "$type": "dimension",
      "$value": "16px",
      "$description": "4-px grid"
    },
    "s5": {
      "$type": "dimension",
      "$value": "24px",
      "$description": "4-px grid"
    },
    "s6": {
      "$type": "dimension",
      "$value": "32px",
      "$description": "4-px grid"
    }
