<?xml version="1.0" encoding="utf-8"?>
<!-- the «Поток» orb (home WaveOrb): a deep glass core with a violet light, and its ring -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape android:shape="oval"><solid android:color="#FF0D0D14" /></shape></item>
    <item><shape android:shape="oval"><gradient android:type="radial" android:gradientRadius="40dp" android:centerX="0.38" android:centerY="0.32" android:startColor="#998C7BFF" android:centerColor="#335874EA" android:endColor="#000D0D14" /></shape></item>
    <item><shape android:shape="oval"><stroke android:width="2.5dp" android:color="#FF7896FF" /></shape></item>
    <item android:inset="2.5dp"><shape android:shape="oval"><stroke android:width="1dp" android:color="#66D49838" /></shape></item>
</layer-list>
