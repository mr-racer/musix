<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile check for the Kiota-generated C# client (generated/ is not committed). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Musix.Api.Client</RootNamespace>
    <NoWarn>$(NoWarn);CS8618</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="2.1.2" />
  </ItemGroup>
</Project>
